OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Anthropic live finance_eval runner
ANTHROPIC_API_KEY=

# Client API runner — put the *value* here; the UI/API store only the variable *name*.
# Example: set auth_env_var=CLIENT_API_TOKEN on the project API target.
CLIENT_API_TOKEN=

# SQLite location. Relative paths are resolved from the working directory.
EVAL_DB_PATH=data/evals.db

# Import limits
EVAL_MAX_IMPORT_CASES=10000
EVAL_MAX_IMPORT_FILE_BYTES=20971520

# Finance live runner defaults (optional; CLI flags override)
# FINANCE_EVAL_MAX_COST_USD=1.0
# FINANCE_EVAL_MAX_RETRIES=2
