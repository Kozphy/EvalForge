# Optional: only needed for the OpenAI structured grader.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# SQLite location. Relative paths are resolved from the working directory.
EVAL_DB_PATH=data/evals.db

# Optional append-only JSONL mirror for vendor-neutral trace events.
# Leave empty to keep traces only in SQLite.
EVAL_TRACE_JSONL_PATH=

# Import limits
EVAL_MAX_IMPORT_CASES=10000
EVAL_MAX_IMPORT_FILE_BYTES=20971520
