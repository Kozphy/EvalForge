# Optional: only needed for the OpenAI structured grader.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# SQLite location. Relative paths are resolved from the working directory.
EVAL_DB_PATH=data/evals.db

# Retrieval backend: tfidf (default, lightweight) or torch (optional).
EVAL_RETRIEVAL_BACKEND=tfidf
EVAL_TORCH_DEVICE=auto
EVAL_TORCH_RETRIEVAL_DIMENSIONS=2048
EVAL_TORCH_RETRIEVAL_BATCH_SIZE=128

# Import limits
EVAL_MAX_IMPORT_CASES=10000
EVAL_MAX_IMPORT_FILE_BYTES=20971520
